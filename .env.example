# ===========================================================================
# .env.example — Variables globales para docker-compose.yml
# Proyecto Integrador Primer Parcial — Desarrollo Software Seguro (ESPE)
# ===========================================================================

# --- Base de datos de AUTH (PostgreSQL) ---
AUTH_DB_DATABASE=user_db
AUTH_DB_USERNAME=user_app
AUTH_DB_PASSWORD=User_DB_2026.Change.This.Password

# --- Base de datos de STEGO (PostgreSQL) ---
STEGO_DB_NAME=stego_db
STEGO_DB_USER=stego_app
STEGO_DB_PASSWORD=Stego_DB_2026.Change.This.Password

# --- Tokens y Claves JWT (RS256) ---
JWT_ISSUER=auth-ms
JWT_AUDIENCE=stego-ms

# --- Credencial de Servicio S2S (STEGO -> AUTH) ---
AUTH_SERVICE_CREDENTIAL=stego-service-secret-token-change-in-production
