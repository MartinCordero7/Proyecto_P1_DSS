# ===== STEGO Microservice Configuration =====
# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" al repositorio.
PORT=4000
NODE_ENV=development

# Storage Paths (relative to microservice root or absolute path in container)
STORAGE_TEMP_PATH=./storage/temporary
STORAGE_QUARANTINE_PATH=./storage/quarantine

# Image Validation Limits
# Max file size in bytes (e.g. 5242880 = 5MB)
MAX_FILE_SIZE_BYTES=5242880
# Max dimensions in pixels
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=image/png,image/bmp

# ===== AUTH Microservice Integration =====
# AUTH publica su verificación en /api/v1/auth/internal/authorization/check; STEGO añade /internal/authorization/check
AUTH_BASE_URL=http://localhost:3001/api/v1/auth
AUTH_PUBLIC_KEY_PATH=./src/config/keys/auth_public_key.pem
# Service Credential for S2S communication (STEGO -> AUTH). Reemplazar por un valor secreto real.
AUTH_SERVICE_CREDENTIAL=CHANGE_ME_SERVICE_CREDENTIAL
# Timeout in milliseconds for AUTH requests
AUTH_TIMEOUT=5000

# JWT Verification Claims Expectations (deben coincidir con el emisor/audiencia configurados en AUTH)
JWT_ISSUER=auth-ms
JWT_AUDIENCE=stego-ms
JWT_ALGORITHM=RS256

# ===== Steganography engine (Persona 2) =====
# Puntaje de anomalía (0-1) a partir del cual una imagen se marca "sospechoso" (cuarentena)
STEGO_SUSPICIOUS_THRESHOLD=0.75
# Por debajo de este puntaje la imagen es "sin_indicios"; entre ambos umbrales es "no_concluyente"
STEGO_CLEAN_THRESHOLD=0.40

# ===== STEGO database (PostgreSQL propio de STEGO) =====
STEGO_DB_HOST=localhost
STEGO_DB_PORT=5433
STEGO_DB_USER=stego_app
# Define una contraseña propia y segura (mínimo 12 caracteres). No uses la de AUTH.
STEGO_DB_PASSWORD=CHANGE_ME_STEGO_DB_PASSWORD
STEGO_DB_NAME=stego_db
STEGO_DB_SSL=false
