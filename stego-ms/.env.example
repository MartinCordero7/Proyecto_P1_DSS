# STEGO Microservice Configuration
PORT=4000
NODE_ENV=development

# Storage Paths (relative to microservice root or absolute path in container)
STORAGE_TEMP_PATH=./storage/temporary
STORAGE_QUARANTINE_PATH=./storage/quarantine

# Image Validation Limits
# Max file size in bytes (e.g. 5242880 = 5MB)
MAX_FILE_SIZE_BYTES=5242880
# Max dimensions in pixels
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=image/png,image/bmp

# AUTH Microservice Integration
AUTH_BASE_URL=http://localhost:3000
AUTH_PUBLIC_KEY_PATH=./src/config/keys/auth_public_key.pem
# Service Credential for S2S communication (STEGO -> AUTH)
AUTH_SERVICE_CREDENTIAL=stego-service-secret-token-change-in-production
# Timeout in milliseconds for AUTH requests
AUTH_TIMEOUT=5000

# JWT Verification Claims Expectations
JWT_ISSUER=auth-ms
JWT_AUDIENCE=stego-ms
JWT_ALGORITHM=RS256

